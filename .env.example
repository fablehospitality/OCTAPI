# Copy to .env and fill in. Never commit .env.

# Partner's Peek OCTO API: the key Peek issues so YOU can resell THEIR tours.
PARTNER_OCTO_BASE_URL=https://octo.peek.com/integrations/octo
PARTNER_OCTO_API_KEY=

# Your own Peek OCTO API: only used to register the booking webhook.
MY_OCTO_BASE_URL=https://octo.peek.com/integrations/octo
MY_OCTO_API_KEY=

# Username/password that booking notifications must send (pick long random values).
INTAKE_USER=
INTAKE_PASS=

# Public HTTPS address where this connector is deployed, e.g. https://connector.example.com
PUBLIC_URL=

# Optional: Slack incoming webhook or Zapier catch hook for alerts.
ALERT_WEBHOOK_URL=

# Share of each partner booking you keep (0.25 = 25%). Override per tour with
# "commissionRate" in mappings.json.
COMMISSION_RATE=0.25

PORT=3000
MAPPINGS_FILE=mappings.json
DATA_FILE=data/bookings.json
